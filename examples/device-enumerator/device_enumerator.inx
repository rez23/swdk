; device_enumerator.inf

; ==== Version Section ====

[Version]
Signature                              = "$Windows NT$"
Class                                  = HIDClass
ClassGUID                              = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider                               = %ManufacturerName%
CatalogFile                            = device_enumerator.cat
PnpLockdown                            = 1
DriverVer                              =

; ==== SourceDisksNames Section ====

[SourceDisksNames]
1                                      = %DiskName%,,,""

; ==== SourceDisksFiles Section ====

[SourceDisksFiles]
device_enumerator.sys                    = 1,,

; ==== DestinationDirs Section ====

[DestinationDirs]
device_enumerator_Device_CopyFiles       = 13

; ==== Manufacturer Section ====

[Manufacturer]
%ManufacturerName%                     = Standard,NT$ARCH$.10.0...16299

; ==== Models Section ====

[Standard.NT$ARCH$.10.0...16299]
%device_enumeratorDeviceName%            = device_enumerator_Device, HID\VID_045E&PID_028E&IG_00
; ==== DDInstall Section ====

[device_enumerator_Device]
CopyFiles                              = device_enumerator_Device_CopyFiles

[device_enumerator_Device_CopyFiles]
device_enumerator.sys,,,0x00002000 ; COPYFLG_NOSKIP


[device_enumerator_Device.Filters$ARCH$.10.0...16299]
AddFilter                              = device_enumerator, 0x00000008, device_enumerator_Filter_Metadata ; FLG_ADDREG_APPEND

[device_enumerator_Filter_Metadata]
FilterPosition                         = Lower


; ==== DDInstall.Services Section ====

[device_enumerator_Device.Services]
AddService                             = device_enumerator,%SPSVCINST_ASSOCSERVICE%,device_enumerator_Device_Service_AddService

[device_enumerator_Device_Service_AddService]
DisplayName                            = %device_enumeratorServiceDisplayName%
ServiceType                            = 1 ; SERVICE_KERNEL_DRIVER
StartType                              = 3 ; SERVICE_DEMAND_START
ErrorControl                           = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary                          = %13%\device_enumerator.sys

; ==== DDInstall.Wdf Section ====

[device_enumerator_Device.Wdf]
KmdfService                            = device_enumerator,device_enumerator_Device_Wdf_KmdfService

[device_enumerator_Device_Wdf_KmdfService]
KmdfLibraryVersion                     = $KMDFVERSION$

; ==== Strings Section ====

[Strings]
ManufacturerName                       = "Spartaco Amadei"
DiskName                               = "device_enumerator Installation Disk"
device_enumeratorDeviceName              = "device_enumerator Device"
device_enumeratorServiceDisplayName      = "device_enumerator Service"

; Service Installation Flags
SPSVCINST_ASSOCSERVICE                 = 0x00000002